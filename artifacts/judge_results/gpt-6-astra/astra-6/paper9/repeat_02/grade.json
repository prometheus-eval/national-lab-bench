     "rubric": "direction",
     "gate": "G3",
     "code": "criterion_not_met",
     "observed_value": "disagrees",
     "accepted_values": [
      "agrees_well"
     ],
     "question": "Does the empirically measured scaling agree with the kernel's stated theoretical scaling within a factor of 2-3 across the sweep?",
     "reason": "Empirical scaling does not show the predicted asymptotic trend, or shows a different exponent than the kernel's theoretical scaling.",
     "judge_reason": "The measurements do not show the stated asymptotic precision-improvement trend: fitted log-precision powers are 0.916 for beta and 0.920 for f2, while the conditional analytical weight bound predicts a reduction from 1+3/(2 beta) to 5/2. The paper explicitly says these asymptotic exponents are not established and does not supply a factor-of-2–3 comparison between predicted and measured reductions. This is failure to demonstrate the predicted asymptotic trend, not a refutation of the conditional bound.",
     "evidence": [
      "proposal/sections/discussion.tex:25–41",
      "proposal/sections/results.tex:64–74",
      "proposal/logs/fit_table.tex:12–17",
      "proposal/logs/analysis.json: fits"
     ]
    },
    {
